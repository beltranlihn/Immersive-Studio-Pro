# dependencies & build output (regenerable via npm install / npm run dist)
node_modules/
dist/
native/*/build/
native/*/node_modules/

# logs & scratch artifacts
*.log
scratchpad/out/
scratchpad/*.log
scratchpad/*.output
scratchpad/*.png

# OS cruft
Thumbs.db
.DS_Store

# Claude Code: versionar el tooling reusable (skills/agents/commands/settings),
# dejar fuera el estado/config local y lo sensible (settings.local.json, caches, etc.)
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/commands/
!.claude/settings.json
.claude/settings.local.json
.claude/*.local.json

# volcados de fotogramas y videos de las sondas CDP (regenerables con scratchpad/*.mjs, pesan cientos de MB)
scratchpad/**/*.png
scratchpad/**/*.mp4
scratchpad/**/*.jpg
scratchpad/autosave/
scratchpad/*.isp
scratchpad/*.json

# [R294] El binario de FFmpeg NO va al repositorio: son 213 MB por plataforma, y git no es un sitio para eso
# -cada clon se los traeria, y cada actualizacion los duplicaria en el historial para siempre-. Se coloca a
# mano en vendor/ffmpeg/<plataforma>/ y electron-builder lo mete en el instalador desde ahi.
# Como conseguirlo: docs/FFMPEG.md, seccion «El binario».
vendor/ffmpeg/win/*
vendor/ffmpeg/mac/*
!vendor/ffmpeg/*/.gitkeep
